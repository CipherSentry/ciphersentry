# B7 production ops — copy to prod.env (never commit secrets)
# Keys: prefer *_FILE mounts (K8s secret / docker secret / vault agent)

CS_ENV=production
# equivalent: B7=1

AUTH_REQUIRED=1
REDIS_URL=redis://your-managed-valkey:6379
REDIS_REQUIRE=1
NATS_URL=nats://your-managed-nats:4222
NATS_REQUIRE=1
INDEXER_REQUIRE_NATS=1

# Key custody (file beats env)
# PROTOCOL_KEY_FILE=/run/secrets/protocol_key
# BATCHER_KEY_1_FILE=/run/secrets/batcher_1
# BATCHER_KEY_2_FILE=/run/secrets/batcher_2
# BATCHER_KEY_3_FILE=/run/secrets/batcher_3
# RULER_KEY_FILE=/run/secrets/ruler_key
# or inject via orchestrator secret env (still not in git):
# PROTOCOL_KEY=0x…
# BATCHER_KEY_1=0x…
# BATCHER_KEY_2=0x…
# BATCHER_KEY_3=0x…

CHAIN_RPC=https://…
CHAIN_ID=84532
ESCROW_ADDRESS=0x…
BATCHER_ADDRESS=0x…
SLASH_EXECUTOR_ADDRESS=0x…
PROTOCOL_FROM=0x…

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
