# B7 production ops — copy to services/prod.env (never commit)
# Hosted paths:
#   docker compose -f services/docker-compose.b7.yml --env-file services/prod.env up -d
#   bash services/scripts/b7-host.sh init && bash services/scripts/b7-host.sh compose
#   # bare metal (managed Redis/NATS already up):
#   bash services/scripts/b7-host.sh up

CS_ENV=production
# equivalent: B7=1

AUTH_REQUIRED=1
# compose.b7 overrides these to service DNS; bare-metal uses host URLs:
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRE=1
NATS_URL=nats://127.0.0.1:4222
NATS_REQUIRE=1
INDEXER_REQUIRE_NATS=1

# Key custody — file mounts preferred (compose: services/secrets/ → /run/secrets/)
# PROTOCOL_KEY_FILE=/run/secrets/protocol_key
# BATCHER_KEY_1_FILE=/run/secrets/batcher_1
# BATCHER_KEY_2_FILE=/run/secrets/batcher_2
# BATCHER_KEY_3_FILE=/run/secrets/batcher_3
# RULER_KEY_FILE=/run/secrets/ruler_key
# fallback env (still not in git):
# PROTOCOL_KEY=0x…
# BATCHER_KEY_1=0x…
# BATCHER_KEY_2=0x…
# BATCHER_KEY_3=0x…

# Chain (optional for B7 health; required for on-chain writes)
# CHAIN_RPC=https://base-sepolia.g.alchemy.com/v2/KEY
# CHAIN_ID=84532
# ESCROW_ADDRESS=0x
# BATCHER_ADDRESS=0x
# SLASH_EXECUTOR_ADDRESS=0x
# USDC_ADDRESS=0x
# PROTOCOL_FROM=0x


GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
INDEXER_PORT=8090

PG_USER=cent
PG_PASSWORD=cent
PG_DB=ciphersentry
CH_DB=ciphersentry
CH_USER=cent
CH_PASSWORD=cent
