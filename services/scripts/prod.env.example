# B7 production ops — copy to services/prod.env (never commit)
# Hosted paths:
#   docker compose -f services/docker-compose.b7.yml --env-file services/prod.env up -d
#   bash services/scripts/b7-host.sh init && bash services/scripts/b7-host.sh compose
#   # bare metal (managed Redis/NATS already up):
#   bash services/scripts/b7-host.sh up

CS_ENV=production
# equivalent: B7=1

AUTH_REQUIRED=1
# compose.b7 overrides these to service DNS; bare-metal uses host URLs:
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRE=1
NATS_URL=nats://127.0.0.1:4222
NATS_REQUIRE=1
INDEXER_REQUIRE_NATS=1

# Key custody — file mounts preferred (compose: services/secrets/ → /run/secrets/)
# PROTOCOL_KEY_FILE=/run/secrets/protocol_key
# BATCHER_KEY_1_FILE=/run/secrets/batcher_1
# BATCHER_KEY_2_FILE=/run/secrets/batcher_2
# BATCHER_KEY_3_FILE=/run/secrets/batcher_3
# RULER_KEY_FILE=/run/secrets/ruler_key
# fallback env (still not in git):
# PROTOCOL_KEY=0x…
# BATCHER_KEY_1=0x…
# BATCHER_KEY_2=0x…
# BATCHER_KEY_3=0x…

# Chain (required for on-chain writes on public demo)
# Prefer publicnode for writes — Alchemy can reject EIP-7702 delegated EOAs
# under "in-flight transaction limit for delegated accounts".
# CHAIN_RPC=https://base-sepolia.publicnode.com
# CHAIN_ID=84532
# Mock stack (see cipher/contracts/deployments/base-sepolia-mockusdc.json):
# ESCROW_ADDRESS=0xB41EC9A2E9fD7b9226E53a93daef0E1655729890
# BATCHER_ADDRESS=0x66855FBa76034B04053E6C419c0af1FE55867669
# USDC_ADDRESS=0x4fa4890F31143C5158eD0Aa95d80815bFd3580D0
# SLASH_EXECUTOR_ADDRESS=0x39b0D1E0fED8e22775631974402bc5f6CFa9865b
# PROTOCOL_FROM=0x…


GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
INDEXER_PORT=8090

PG_USER=cent
PG_PASSWORD=cent
PG_DB=ciphersentry
CH_DB=ciphersentry
CH_USER=cent
CH_PASSWORD=cent
