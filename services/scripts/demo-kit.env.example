# CipherSentry external demo kit (NOT for CI)
#   cp services/scripts/demo-kit.env.example services/scripts/demo-kit.env
#   # edit keys/RPC, then:
#   set -a && source services/scripts/demo-kit.env && set +a
#   bash services/scripts/demo-sepolia.sh
#
# Local (no keys): DEMO_LOCAL=1 WITH_COMPOSE=1 DEMO_HOLD=0 bash services/scripts/demo-sepolia.sh

# DEMO_LOCAL=1  # anvil + deploy-local (skip Sepolia keys)
# DEMO_HOLD=0   # exit after settle (CI/scripts); default 1 holds processes
# WITH_COMPOSE=1  # pg+ch+nats for live /trust chart

# --- RPC / chain ---
# Alchemy / publicnode Base Sepolia
CHAIN_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# or: CHAIN_RPC=https://base-sepolia.publicnode.com
CHAIN_ID=84532

# Funded deployer (0x-prefixed). Required for on-chain commit/anchor.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
PROTOCOL_KEY=
# leave PROTOCOL_KEY empty → demo uses PRIVATE_KEY

# --- deployed stack (mock USDC write path by default) ---
# Mode: mock | circle
DEMO_STACK=mock

# mock USDC write stack (from deployments/base-sepolia-mockusdc.json)
ESCROW_ADDRESS=0xB41EC9A2E9fD7b9226E53a93daef0E1655729890
BATCHER_ADDRESS=0x66855FBa76034B04053E6C419c0af1FE55867669
USDC_ADDRESS=0x4fa4890F31143C5158eD0Aa95d80815bFd3580D0
SLASH_EXECUTOR_ADDRESS=0x39b0D1E0fED8e22775631974402bc5f6CFa9865b
PROTOCOL_FROM=0x96a438924ACE133D5909bd3BAF3263845B760eF4

# circle USDC production (watch/read unless you hold Circle USDC + approve)
# ESCROW_ADDRESS=0xa97E729Fdb0002705a19cDd4F39FE551f3d77BB2
# BATCHER_ADDRESS=0x72b735E47983ACb9039bb1f1B757BF9c09f4bfca
# USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# SLASH_EXECUTOR_ADDRESS=0xCE3b3854BAdC63eafb097E0d0E1e0F156124514a

# --- local services ---
GATEWAY_PORT=8080
INDEXER_PORT=8081
AUTH_REQUIRED=0
# NATS optional for demo (memory bus if empty)
NATS_URL=
# set to 1 to start docker compose (pg+ch+nats) and live trust chart
WITH_COMPOSE=1

# frontend (optional — open after settle)
# CIPHER_URL=http://127.0.0.1:5173
CIPHER_URL=http://127.0.0.1:4173
